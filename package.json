{
  "name": "ohif-viewer",
  "displayName": "OHIF Viewer",
  "description": "OHIF Viewer integrated with VSCode",
  "publisher": "kubzoey95",
  "icon": "icon.png",
  "author": {
    "name": "Jakub Belicki",
    "email": "jakubsliwice@o2.pl",
    "url": "https://github.com/kubzoey95"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kubzoey95/ohif-viewer-vscode.git"
  },
  "license": "MIT",
  "version": "1.0.7",
  "engines": {
    "vscode": "^1.89.0"
  },
  "categories": [
    "Visualization",
    "Data Science",
    "Other"
  ],
  "keywords": [
    "neuroimaging",
    "medical",
    "imaging",
    "neuroscience",
    "MRI",
    "CT",
    "brain",
    "tomography",
    "DICOM",
    "DCM",
    "viewer",
    "OHIF"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "dcmView",
        "displayName": "OHIF Viewer",
        "selector": [
          {
            "filenamePattern": "*.dcm"
          }
        ],
        "priority": "default"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile-extension && node scripts/prepare-release.cjs && npm run lint && npm run check-types && node --test tests/webview.cjs",
    "compile": "npm run compile-extension && npm run build-viewer",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "vscode-test",
    "postinstall": "cd Viewers && corepack pnpm install",
    "build-viewer": "cd Viewers && APP_CONFIG=../../../../ohifConfig.js PUBLIC_URL=./ corepack pnpm run build && cd .. && node scripts/copy-viewer.cjs",
    "compile-extension": "esbuild ./src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node && esbuild ./src/webview-worker.js --outfile=out/webview-worker.js --platform=browser",
    "test:webview": "npm run compile-extension && node --test tests/webview.cjs",
    "check-types": "tsc --noEmit",
    "release:package": "vsce package --no-dependencies --no-yarn"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "^18.19.33",
    "@types/vscode": "^1.89.0",
    "@typescript-eslint/eslint-plugin": "^7.0.2",
    "@typescript-eslint/parser": "^7.0.2",
    "@vscode/test-cli": "^0.0.6",
    "@vscode/test-electron": "^2.3.9",
    "esbuild": "^0.21.4",
    "eslint": "^8.56.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "dcmjs": "^0.33.0",
    "glob": "^10.4.1"
  }
}
